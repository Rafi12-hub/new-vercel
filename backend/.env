PORT=5000
JWT_SECRET=supersecretkey_rgm_compiler
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=YOUR_RAPIDAPI_KEY_HERE

# Firebase Admin SDK Configuration
# Get service account JSON from Firebase Console > Project Settings > Service accounts
# Then copy the values below
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Firebase Auth REST API Key (from Project Settings > General > Web API Key)
# IMPORTANT: Must match VITE_FIREBASE_API_KEY in frontend/.env
FIREBASE_API_KEY=your-firebase-api-key
