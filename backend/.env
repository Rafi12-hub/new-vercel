# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# JWT AUTHENTICATION
# ========================================
JWT_SECRET=supersecretkey_rgm_compiler_change_in_prod

# ========================================
# JUDGE0 CODE EXECUTION API
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
# ========================================
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=YOUR_RAPIDAPI_KEY_HERE

# ========================================
# FIREBASE ADMIN SDK Configuration
# Get service account JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ========================================
FIREBASE_PROJECT_ID=rgmcse-compiler
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@YOUR-PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=rgmcse-compiler.appspot.com

# Firebase Auth REST API Key (from Project Settings > General > Web API Key)
# IMPORTANT: Must match VITE_FIREBASE_API_KEY in frontend/.env
FIREBASE_API_KEY=AIzaSyANaYM4a-bk4jS6kPegLlAjTU_ZgkjorB0

# ========================================
# MONGODB CONNECTION
# Get URI from: MongoDB Atlas > Connect > Copy connection string
# ========================================
# Example: mongodb+srv://username:password@cluster0.mongodb.net/rgmcse-compiler
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxx.mongodb.net/rgmcse-compiler?retryWrites=true&w=majority

# ========================================
# PRODUCTION DEPLOYMENT URLS
# ========================================
# Update these for production
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
